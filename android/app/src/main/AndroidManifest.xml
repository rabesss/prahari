<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Package visibility for the screen-sharing app warning only (RemoteApps.kt): named packages, no all-packages permission. -->
    <queries>
        <package android:name="com.anydesk.anydeskandroid"/>
        <package android:name="com.teamviewer.quicksupport.market"/>
        <package android:name="com.teamviewer.host.market"/>
        <package android:name="com.teamviewer.teamviewer.market.mobile"/>
        <package android:name="com.carriez.flutter_hbb"/>
        <package android:name="com.sand.airdroid"/>
        <package android:name="com.sand.airsos"/>
        <package android:name="com.sand.aircast"/>
    </queries>
    <application android:label="Prahari" android:allowBackup="false" android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTop" android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize" android:enableOnBackInvokedCallback="true">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
            <intent-filter android:label="Check with Prahari">
                <action android:name="android.intent.action.PROCESS_TEXT"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
