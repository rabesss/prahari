#!/usr/bin/env bash
# Contract entry point: bin/predict --task {sms,url,flow} --in IN.jsonl --out OUT.jsonl (one output row per input row). Uses the shared project venv unless HC_PY is set.
set -euo pipefail
C="$(cd "$(dirname "$0")/.." && pwd)"
PY="${HC_PY:-$C/../../.venv/bin/python}"
PYTHONPATH="$C${PYTHONPATH:+:$PYTHONPATH}" exec "$PY" -m triage.cli predict "$@"
